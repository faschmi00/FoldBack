<?xml version="1.0" encoding="utf-8"?>
<!-- Backup- und Übertragungsregeln ab Android 12. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Encrogram: Geräte-Kennung gehört zu genau diesem Gerät. -->
        <exclude domain="sharedpref" path="encrogram.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="encrogram.xml" />
    </device-transfer>
</data-extraction-rules>
